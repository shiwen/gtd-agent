page {
  background: #0B1220;
  color: #E6F6FF;
  font-size: 28rpx;
}

.container {
  padding: 28rpx 28rpx 120rpx;
}

.titleRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 24rpx;
}

.btnPrimary {
  background: linear-gradient(135deg, #22D3EE, #60A5FA);
  color: #081226;
  border-radius: 999rpx;
  padding: 16rpx 22rpx;
  font-weight: 700;
}

.btnGhost {
  background: rgba(255, 255, 255, 0.06);
  color: #E6F6FF;
  border-radius: 999rpx;
  padding: 16rpx 22rpx;
}

.input {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 18rpx;
  padding: 18rpx 18rpx;
  color: #E6F6FF;
}

.muted {
  color: rgba(230, 246, 255, 0.65);
}

.row {
  display: flex;
  align-items: center;
}

.gap12 { gap: 12rpx; }
.gap16 { gap: 16rpx; }

